# ProxyAPI (OpenAI-совместимый API)
PROXY_API_KEY=ваш_ключ_proxyapi
OPENAI_BASE_URL=https://api.proxyapi.ru/v1
OPENAI_MODEL=openai/gpt-5.6-luna

# Температура генерации (0..2). Меньше — детерминированнее ответ.
# ВАЖНО: параметр ПЕРЕДАЁТСЯ в запросы к LLM (для гибкости при смене
# модели или провайдера). Модель openai/gpt-5.6-luna через ProxyAPI
# может не поддерживать temperature (провайдер использует дефолт 1);
# при ошибке 400 с упоминанием temperature запрос повторяется без него.
# Статус на 2026-10-04: провайдер temperature=1.0 принял, повтор не понадобился.
TEMPERATURE=0.2

# Лимиты
RATE_LIMIT_PER_MINUTE=5
# Размер окна лимитирования в секундах: запросы считаются за последние
# RATE_WINDOW_SECONDS секунд (скользящее окно). По умолчанию 60 («в минуту»).
RATE_WINDOW_SECONDS=60
MAX_TEXT_LENGTH=2000

# Логирование
LOG_LEVEL=INFO
# Режим записи файла логов: write | append.
#   write  — logs/app.log пересоздаётся при каждом запуске (для отладки);
#   append — накапливается между запусками (история сохраняется).
# Значение по умолчанию, если переменная не задана, — write.
LOG_MODE=write

# База данных (SQLite)
# Путь к файлу БД относительно корня проекта. Значение по умолчанию,
# если переменная не задана, — tickets.db. Файл и родительские папки
# создаются автоматически при первом обращении. Файл БД в git не попадает.
DB_PATH=tickets.db