# ProxyAPI (OpenAI-совместимый API)
PROXY_API_KEY=ваш_ключ_proxyapi
OPENAI_BASE_URL=https://api.proxyapi.ru/v1
OPENAI_MODEL=openai/gpt-5.6-luna

# Температура генерации (0..2). Меньше — детерминированнее ответ.
# ВАЖНО: параметр ПЕРЕДАЁТСЯ в запросы к LLM (для гибкости при смене
# модели или провайдера). Модель openai/gpt-5.6-luna через ProxyAPI
# не поддерживает temperature (провайдер использует дефолт 1), но
# если провайдер ответит ошибкой 400 — запрос повторится без него.
TEMPERATURE=0.2

# Лимиты
RATE_LIMIT_PER_MINUTE=5
MAX_TEXT_LENGTH=2000

# Логирование
LOG_LEVEL=INFO